FROM tgi-ppc64le:pytorch

ARG TGI_REF=main

RUN conda install -y -n tgi -c conda-forge \
        grpcio grpcio-tools grpcio-status grpcio-reflection libgrpc \
        sentencepiece httptools pillow \
        "opentelemetry-api>=1.27.0" \
        "opentelemetry-sdk>=1.27.0" \
        "opentelemetry-exporter-otlp>=1.27.0" && \
    conda clean -afy

# The 1.1.0 sdist points python-source at a missing directory (xet-core#255)
RUN if ls /opt/package/hf_xet-*.whl >/dev/null 2>&1; then \
        pip install --no-cache-dir /opt/package/hf_xet-*.whl ; \
    else \
        pip install --no-cache-dir maturin patchelf && \
        mkdir -p /tmp/hfxet && cd /tmp/hfxet && \
        curl -sSL -o hf_xet.tar.gz \
          https://files.pythonhosted.org/packages/source/h/hf_xet/hf_xet-1.1.0.tar.gz && \
        tar xzf hf_xet.tar.gz && cd hf_xet-1.1.0 && \
        sed -i '/python-source/d' pyproject.toml && \
        maturin build --release && \
        pip install --no-cache-dir hf_xet/target/wheels/hf_xet-*.whl && \
        cd / && rm -rf /tmp/hfxet ; \
    fi && \
    python -c "import hf_xet; print('hf_xet ok')"

RUN git clone https://github.com/huggingface/text-generation-inference.git tgi && \
    cd tgi && git checkout ${TGI_REF}

WORKDIR /opt/build/tgi

# Repo pins 1.85.1, too old for current crates; 1.98 breaks metrics 0.23
RUN sed -i 's/^channel = .*/channel = "1.88.0"/' rust-toolchain.toml

# ngrok pulls ring 0.16.20, whose build.rs panics on powerpc64le.
# Without it rustls falls back to aws-lc-rs, which supports the arch.
RUN for f in router/Cargo.toml backends/v2/Cargo.toml backends/v3/Cargo.toml \
             backends/trtllm/Cargo.toml backends/llamacpp/Cargo.toml; do \
        [ -f "$f" ] || continue; \
        sed -i 's/^default = \["ngrok"\]/default = []/' "$f"; \
        sed -i '/^ngrok = { version/d' "$f"; \
        sed -i '/^ngrok = \["dep:ngrok"\]/d' "$f"; \
        sed -i '/^ngrok = \["text-generation-router\/ngrok"\]/d' "$f"; \
    done

# The cfg(not(feature="ngrok")) branch references undefined variables;
# it only ever compiled because the feature was always on by default
RUN sed -i '/let _ngrok_authtoken = ngrok_authtoken;/d; \
            /let _ngrok_domain = ngrok_domain;/d; \
            /let _ngrok_username = ngrok_username;/d; \
            /let _ngrok_password = ngrok_password;/d' router/src/server.rs

# Drop pins that would rebuild conda-provided packages, downgrade numpy
# below what local torch expects, or pull torch cu128 (x86_64/aarch64 only)
RUN cd server && \
    sed -i '/^grpcio==/d; /^grpcio-reflection==/d; /^grpcio-status==/d; /^grpcio-tools==/d' requirements_gen.txt && \
    sed -i '/^sentencepiece==/d; /^torch==/d; /^hf-xet==/d' requirements_gen.txt && \
    sed -i '/^pillow==/d; /^numpy==/d; /^protobuf==/d' requirements_gen.txt && \
    sed -i '/^ *"torch==/d; /^ *"torch>=/d' pyproject.toml

# Hub kernels ship x86_64 and aarch64 only, and dropout_layer_norm needs
# BUILD_EXTENSIONS=True plus SM80+. Both patches fall back to native PyTorch.
COPY patches/kernels.py   server/text_generation_server/utils/kernels.py
COPY patches/layernorm.py server/text_generation_server/layers/layernorm.py

# Gencode and protobuf runtime must share a major version. grpc_tools from
# conda embeds protoc 7.x, and the pip grpcio-tools is not an option here
# (it pulls grpcio, which has no ppc64le wheel and fails to build).
RUN python -c "import google.protobuf; print('protobuf (before)', google.protobuf.__version__)"

# Protos generated by hand: 'uv sync' creates its own venv and discards the
# conda environment. --system is needed since uv does not treat conda as a venv.
RUN cd server && \
    pip install --no-cache-dir uv && \
    uv pip install --system -r requirements_gen.txt && \
    rm -rf text_generation_server/pb && \
    mkdir -p text_generation_server/pb && \
    python -m grpc_tools.protoc -I../proto/v3 \
      --python_out=text_generation_server/pb \
      --grpc_python_out=text_generation_server/pb \
      --mypy_out=text_generation_server/pb \
      ../proto/v3/generate.proto && \
    find text_generation_server/pb/ -type f -name "*.py" -print0 \
      -exec sed -i -e 's/^\(import.*pb2\)/from . \1/g' {} \; && \
    touch text_generation_server/pb/__init__.py && \
    python -c "import google.protobuf; print('protobuf (after)', google.protobuf.__version__)"

RUN cd server && pip install -e . --no-build-isolation --no-deps

# openssl-sys builds against system OpenSSL 1.1.1, but the linker would pick
# conda's libcrypto 3.x first: undefined reference to EVP_PKEY_id
ENV OPENSSL_DIR=/usr \
    OPENSSL_LIB_DIR=/usr/lib64 \
    OPENSSL_INCLUDE_DIR=/usr/include \
    PKG_CONFIG_PATH=/usr/lib64/pkgconfig

RUN cargo install --path launcher/ --locked && \
    cargo install --path backends/v3 --locked

# compressed-tensors >= 0.15 imports transformers.masking_utils (absent in
# 4.51.3), and outlines 0.2 moved outlines.fsm.guide.RegexGuide
RUN pip install --no-cache-dir \
        "click<8.2.0" \
        "einops>=0.8.0" \
        "grpc-interceptor>=0.15.4" \
        "kernels==0.5.0" \
        "hf-transfer>=0.1.8" \
        "loguru>=0.7.3" \
        "opentelemetry-instrumentation-grpc>=0.50b0" \
        "prometheus-client>=0.21.0" \
        "py-cpuinfo>=9.0.0" \
        "safetensors>=0.4.5" \
        "tokenizers>=0.20.3,<0.22" \
        "transformers==4.51.3" \
        "huggingface-hub==0.31.1" \
        "peft>=0.10" \
        "accelerate" \
        "outlines>=0.1.13,<0.2" \
        "compressed-tensors==0.9.4"

# No ppc64le build; peft imports it unconditionally and aborts on CUDA setup
RUN pip uninstall -y bitsandbytes || true

# The block above downgrades protobuf to 5.x transitively, breaking the
# 7.35.1 gencode. conda will not reinstall over pip, so restore with pip.
RUN pip install --no-cache-dir --force-reinstall --no-deps "protobuf==7.35.1" && \
    python -c "import google.protobuf; print('protobuf', google.protobuf.__version__)"

# Catches the protobuf mismatch at build time instead of on first request
RUN python -c "import google.protobuf; print('protobuf', google.protobuf.__version__)" && \
    python -c "from text_generation_server.pb import generate_pb2; print('protos ok')" && \
    python -c "import text_generation_server; print('server ok')" && \
    python -c "import compressed_tensors, outlines, peft; print('deps ok')" && \
    text-generation-launcher --version

COPY entrypoint.sh /opt/entrypoint.sh
RUN chmod +x /opt/entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/opt/entrypoint.sh"]
