FROM tgi-ppc64le:base

# libtorch_cpu.so needs sbgemm_, only in recent openblas
RUN conda install -y -n tgi -c conda-forge openblas libopenblas && conda clean -afy

RUN pip install --no-cache-dir \
    typing_extensions filelock sympy networkx jinja2 fsspec

COPY package/ /opt/package/

RUN pip install --no-cache-dir /opt/package/numpy-*-cp311-cp311-linux_ppc64le.whl

# Local torch ships as a tarball, so there is no .dist-info: later pip calls need --no-deps
RUN SITE=$(python -c "import site; print(site.getsitepackages()[0])") && \
    rm -rf $SITE/torch $SITE/torchgen $SITE/torch-*.dist-info && \
    tar xzf /opt/package/torch-*-cp311-cp311-linux_ppc64le.tar.gz -C $SITE

ENV CUDA_HOME=/usr/local/cuda \
    PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/opt/conda/envs/tgi/lib:/usr/local/cuda/lib64:/opt/rh/gcc-toolset-11/root/usr/lib64:$LD_LIBRARY_PATH

# Non-fatal: CUDA is bind-mounted at build time only, real check is in the entrypoint
RUN python -c "import torch; print('torch', torch.__version__)" || \
    echo "WARNING: torch import skipped (CUDA comes from the host at runtime)"
